{
  "name": "esign-saas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fix-permissions.js && node scripts/verify-ta-template.js && node scripts/verify-pma-professional-template.mjs && prisma generate",
    "build": "UV_THREADPOOL_SIZE=2 next build",
    "start": "next start",
    "start:server": "node server.js",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "format": "prettier --write .",
    "build:normal": "prisma generate && next build",
    "db:push": "prisma db push",
    "build:with-db-push": "prisma generate && prisma db push && next build",
    "zip:hostinger": "powershell -ExecutionPolicy Bypass -File scripts/prepare-hostinger-zip.ps1"
  },
  "dependencies": {
